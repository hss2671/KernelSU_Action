CONFIG_ENV=config.env

# ============================================================ Kernel source ==

# 1. 替换为你的 rover 内核源码仓库与分支
KERNEL_SOURCE=https://github.com/hss2671/mobvoi-ticwatch-kernel
KERNEL_SOURCE_BRANCH=mobvoi-android-msm-rover-4.9

# 2. 配置文件：去 arch/arm/configs/ 确认文件名（常见为 rover_defconfig 或 sdm429w-perf_defconfig）
KERNEL_CONFIG=rover_defconfig

# 3. 32 位 ARM 内核构建产物（通常为 zImage 或 zImage-dtb）
KERNEL_IMAGE_NAME=zImage-dtb

# 4. 关键：强行指定 32 位架构（绝对不能填 arm64）
ARCH=arm

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 5. 编译命令：必须指定 32 位 Clang 目标三元组
CUSTOM_CMDS:CC=clang CLANG_TRIPLE=arm-linux-gnu- CROSS_COMPILE=arm-linux-androideabi-
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes

# =================================================================== Clang ==

# 4.9 旧内核必须使用 2022 年的预编译 Clang，新版 Clang 会直接报语法错误
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 4.9 架构不支持 全 LLVM 构建
USE_LLVM=false

# ===================================================================== GCC ==

# 32 位内核必须开启 32 位 GCC 交叉工具链（arm-linux-androideabi-）
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

# 专为旧内核/非 GKI 优化的变体（或选 kernelsu-next / sukisu-ultra）
KSU_VARIANT=resukisu
KSU_REF=

# 4.9 32 位内核优先推荐 auto
KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

# 32 位 4.9 内核不建议开启 SUSFS（补丁极易与旧架构源码冲突）
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# 关键：Linux 4.9 原生缺少 path_umount，KernelSU 卸载挂载点必须依赖此 Backport 补丁！
ENABLE_PATH_UMOUNT=true

ENABLE_HIDE_STUFF=false

# 关键：KPM 仅支持 arm64，32 位 ARM 绝对不能开启！
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false

# 关掉 Werror，避免旧代码因 Warning 直接中断编译
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/hss2671/my-boot/main/boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
