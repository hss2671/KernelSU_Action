CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/hss2671/mobvoi-ticwatch-kernel
KERNEL_SOURCE_BRANCH=mobvoi-android-msm-rover-4.9
KERNEL_CONFIG=rover_defconfig
KERNEL_IMAGE_NAME=zImage-dtb
ARCH=arm

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 纯 GCC 编译的核心命令：显式指定 CC 和 CROSS_COMPILE 的 GCC 绝对路径
CUSTOM_CMDS:CC=/home/runner/work/KernelSU_Action/KernelSU_Action/kernel_workspace/gcc-32/bin/arm-linux-androideabi-gcc CROSS_COMPILE=/home/runner/work/KernelSU_Action/KernelSU_Action/kernel_workspace/gcc-32/bin/arm-linux-androideabi-
EXTRA_CMDS:KCFLAGS=-Wno-error=strict-prototypes
# =================================================================== Clang ==

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=true
CUSTOM_GCC_32_SOURCE=https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9
CUSTOM_GCC_32_BRANCH=lineage-19.1
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

KSU_VARIANT=resukisu
KSU_REF=
KSU_HOOK_MODE=auto
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/hss2671/my-boot/main/boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
