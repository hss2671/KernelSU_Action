# KernelSU Action -- build profile
#
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.
#
# Copy this file to config/<device>.env to keep one profile per device, then
# pick it with the "Config file to build" input when you start a build.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/hss2671/mobvoi-ticwatch-kernel
KERNEL_SOURCE_BRANCH=mobvoi-android-msm-rover-4.9
KERNEL_CONFIG=rover_defconfig
KERNEL_IMAGE_NAME=zImage
ARCH=arm

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags appended to every make invocation.
# This kernel is ARM32 Android and uses Clang with the Android target.
# Do not add CROSS_COMPILE here.

EXTRA_CMDS=CC=clang CLANG_TRIPLE=arm-linux-androideabi-
CUSTOM_CMDS=

# =================================================================== Clang ==

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Keep disabled for this Linux 4.9 kernel.
USE_LLVM=false

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarh64-linux-android-

USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

KSU_VARIANT=resukisu
KSU_REF=

KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# clang r450784e does not support either:
#   -fstack-protector-strong
#   -fstack-protector
#
# Disable both and explicitly select the NONE option.
EXTRA_DEFCONFIG=CONFIG_CC_STACKPROTECTOR_STRONG=n CONFIG_CC_STACKPROTECTOR_REGULAR=n CONFIG_CC_STACKPROTECTOR_NONE=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/osm0sis/AnyKernel3
CUSTOM_ANYKERNEL3_BRANCH=master

# ============================================================== Packaging ===

NEED_DTBO=false

# Boot image will be repacked manually with magiskboot.
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/hss2671/my-boot/main/boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
